msgid ""
"%1$sError:%2$s The nonce security check didn’t pass. Please reload the page "
"and try again. You may want to try clearing your browser cache as a last "
"attempt."
msgstr ""
"%1$sخطا:%2$s بررسی امنیتی nonce انجام نشد. لطفا صفحه را مجددا بارگذاری کنید "
"و دوباره تلاش کنید. به عنوان آخرین تلاش، کش مرورگر خود را پاک کنید."

msgid ""
"%1$sYou have no more activations left.%2$s %3$sPlease upgrade to a more "
"advanced license%4$s (you'll only need to cover the difference)."
msgstr ""
"%1$sهیچ فعال‌سازی دیگری برای شما باقی نمانده است.%2$s %3$sلطفاً به یک لایسنس "
"پیشرفته تر ارتقا دهید%4$s (فقط مابه التفاوت را باید بپردازید)."

msgid ""
"%1$sYour Elementor Pro license has expired.%2$s Want to keep creating secure "
"and high-performing websites? Renew your subscription to regain access to "
"all of the Elementor Pro widgets, templates, updates & more. %3$sRenew "
"now%4$s"
msgstr ""
"%1$sلایسنس المنتور پرو شما منقضی شده است.%2$s آیا می‌خواهید به ایجاد وب سایت "
"های ایمن و با عملکرد بالا ادامه دهید؟ اشتراک خود را تمدید کنید تا دوباره به "
"همه ویجت‌ها، تمپلیت‌ها، به‌روزرسانی‌ها و موارد دیگر المنتو پرو دسترسی پیدا کنید. "
"%3$sتمدید%4$s"

msgid ""
"%1$sYour license key doesn't match your current domain%2$s. This is most "
"likely due to a change in the domain URL of your site (including HTTPS/SSL "
"migration). Please deactivate the license and then reactivate it again."
msgstr ""
"%1$sلایسنس شما با دامنه فعلی شما مطابقت ندارد%2$s. این به احتمال زیاد به "
"دلیل تغییر در URL دامنه سایت شما (از جمله انتقال HTTPS/SSL) است. لطفاً لایسنس "
"را غیرفعال کرده و مجدداً آن را فعال کنید."

msgid ""
"%1$sYour license key doesn't match your current domain%2$s. This is most "
"likely due to a change in the domain URL. Please deactivate the license and "
"then reactivate it again."
msgstr ""
"%1$sلایسنس شما با دامنه فعلی شما مطابقت ندارد%2$s. این به احتمال زیاد به "
"دلیل تغییر در URL دامنه است. لطفاً لایسنس را غیرفعال کرده و مجدداً آن را فعال "
"کنید."

msgid ""
"%1$sYour license key has been cancelled%2$s (most likely due to a refund "
"request). Please consider acquiring a new license."
msgstr ""
"%1$sلایسنس شما لغو شده است%2$s (به احتمال زیاد به دلیل درخواست بازپرداخت). "
"لطفاً در نظر داشته باشید که یک لایسنس جدید دریافت کنید."

msgid ""
"%1$sreCAPTCHA V3%2$s is a free service by Google that protects your website "
"from spam and abuse. It does this while letting your valid users pass "
"through with ease."
msgstr ""
"%1$sریکپچا و3%2$s یک سرویس رایگان توسط گوگل است که از وب سایت شما در برابر "
"هرزنامه و سوء استفاده محافظت می کند. این کار را در حالی انجام می‌دهد که به "
"کاربران معتبر شما اجازه می‌دهد به راحتی از آنجا عبور کنند."

msgid ""
"%1$sreCAPTCHA%2$s is a free service by Google that protects your website "
