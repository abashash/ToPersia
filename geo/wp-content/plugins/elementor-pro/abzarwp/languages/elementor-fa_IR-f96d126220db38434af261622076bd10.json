d\u0627\u0646 \u06a9\u0646\u06cc\u062f\u060c \u06cc\u0627 \u0641\u0639\u0644\u0627 \u0631\u062f \u0634\u0648\u06cc\u062f."],"There was a problem with enabling SVG uploads. Try again, or use another image format.":["\u0645\u0634\u06a9\u0644\u06cc \u062f\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0622\u067e\u0644\u0648\u062f\u0647\u0627\u06cc SVG \u0648\u062c\u0648\u062f \u062f\u0627\u0634\u062a. \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f \u06cc\u0627 \u0627\u0632 \u0641\u0631\u0645\u062a \u062a\u0635\u0648\u06cc\u0631 \u062f\u06cc\u06af\u0631\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f."],"This allows Elementor to scan your SVGs for malicious content. If you do not wish to allow this, use a different image format.":["\u0627\u06cc\u0646 \u0628\u0647 \u0627\u0644\u0645\u0646\u062a\u0648\u0631 \u0627\u062c\u0627\u0632\u0647 \u0645\u06cc\u200c\u062f\u0647\u062f \u062a\u0627 SVG\u0647\u0627\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0645\u062d\u062a\u0648\u0627\u06cc \u0645\u062e\u0631\u0628 \u0627\u0633\u06a9\u0646 \u06a9\u0646\u062f. \u0627\u06af\u0631 \u0646\u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u062f \u0627\u062c\u0627\u0632\u0647 \u062f\u0647\u06cc\u062f\u060c \u0627\u0632 \u0641\u0631\u0645\u062a \u062a\u0635\u0648\u06cc\u0631 \u062f\u06cc\u06af\u0631\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f."],"This file type is not supported. Try a different type of file":["\u0627\u06cc\u0646 \u0646\u0648\u0639 \u0641\u0627\u06cc\u0644 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0646\u0648\u0639 \u062f\u06cc\u06af\u0631\u06cc \u0627\u0632 \u0641\u0627\u06cc\u0644 \u0631\u0627 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f"],"Open Media Library":["\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0631\u0633\u0627\u0646\u0647"],"Drop image here":["\u0639\u06a9\u0633 \u0631\u0627 \u0627\u06cc\u0646\u062c\u0627 \u0631\u0647\u0627 \u06a9\u0646\u06cc\u062f"],"Potential Site Logo":["\u0644\u0648\u06af\u0648 \u0645\u0648\u0631\u062f \u0627\u0646\u062a\u0638\u0627\u0631 \u0633\u0627\u06cc\u062a"],"Otherwise, you can skip this and add one later.":["\u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u0632 \u0627\u06cc\u0646 \u0645\u0648\u0636\u0648\u0639 \u0635\u0631\u0641 \u0646\u0638\u0631 \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0639\u062f\u0627 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f."],"Have a logo? Add it here.":["\u0644\u0648\u06af\u0648 \u062f\u0627\u0631\u06cc\u062f\u061f \u0622\u0646 \u0631\u0627 \u0627\u06cc\u0646\u062c\u0627 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f."],"There was a problem activating Hello Biz Theme.":["\u0645\u0634\u06a9\u0644\u06cc \u062f\u0631 \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u0642\u0627\u0644\u0628 Hello Biz \u0648\u062c\u0648\u062f \u062f\u0627\u0634\u062a."],"Okay, now we're really close...":["\u062e\u0628\u060c \u0627\u0644\u0627\u0646 \u0648\u0627\u0642\u0639\u0627 \u0646\u0632\u062f\u06cc\u06a9\u06cc\u0645..."],"Hold on, this can take a minute...":["\u0644\u0637\u0641\u0627 \u0635\u0628\u0631 \u06a9\u0646\u06cc\u062f, \u0627\u06cc\u0646 \u0645\u06cc\u062a\u0648\u0646\u0647 \u06cc\u06a9\u06cc \u062f\u0648 \u062f\u0642\u06cc\u0642\u0647 \u0637\u0648\u0644 \u0628\u06a9\u0634\u0647..."],"There was a problem installing Hello Biz Theme.":["\u0645\u0634\u06a9\u0644\u06cc \u062f\u0631 \u0646\u0635\u0628 \u0642\u0627\u0644\u0628 Hello Biz \u0648\u062c\u0648\u062f \u062f\u0627\u0634\u062a."],"Continue with Hello Biz Theme":["\u0627\u062f\u0627\u0645\u0647 \u0628\u0627 \u0642\u0627\u0644\u0628 Hello Biz"],"Your site\u2019s got Hello theme. High-five!":["\u0633\u0627\u06cc\u062a \u0634\u0645\u0627 \u062f\u0627\u0631\u0627\u06cc \u067e\u0648\u0633\u062a\u0647 \u0633\u0644\u0627\u0645 \u0627\u0633\u062a. \u0628\u0632\u0646 \u0642\u062f\u0634!"],"Click here to go to Elementor's Kit Library":["\u0628\u0631\u0627\u06cc \u0631\u0641\u062a\u0646 \u0628\u0647 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 Elementor's Kit \u0627\u06cc\u0646\u062c\u0627 \u0631\u0627 \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f"],"Edit a blank canvas with the Elementor Editor":["\u0628\u0627 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 \u0627\u0644\u0645\u0646\u062a\u0648\u0631 \u06cc\u06a9 \u0628\u0648\u0645 \u062e\u0627\u0644\u06cc \u0631\u0648 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u06a9\u0646"],"Click here to create a new page and open it in Elementor Editor":["\u0628\u0631\u0627\u06cc \u0627\u06cc\u062c\u0627\u062f \u06cc\u06a9 \u0635\u0641\u062d\u0647 \u062c\u062f\u06cc\u062f \u0648 \u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u0622\u0646 \u062f\u0631 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 \u0627\u0644\u0645\u0646\u062a\u0648\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0631\u0627 \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f"],"There are three ways to get started with Elementor:":["\u0633\u0647 \u0631\u0627\u0647 \u0628\u0631\u0627\u06cc \u0634\u0631\u0648\u0639 \u0628\u0627 \u0627\u0644\u0645\u0646\u062a\u0648\u0631 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f:"],"That's a wrap! What's next?":[" \u0627\u06cc\u0646 \u06cc\u06a9 \u067e\u0648\u0634\u0634 \u0627\u0633\u062a! \u0628\u0639\u062f\u0634 \u0686\u06cc\u061f"],"Connect your account":["\u062d\u0633\u0627\u0628 \u062e\u0648\u062f \u0631\u0627 \u0648\u0635\u0644 \u06a9\u0646\u06cc\u062f"],"Already have one?":["\u0627\u0632 \u0642\u0628\u0644 \u06cc\u06a9\u06cc \u062f\u0627\u0631\u06cc\u062f\u061f"],"You're here! Let's set things up.":["\u0634\u0645\u0627 \u0627\u06cc\u0646\u062c\u0627 \u0647\u0633\u062a\u06cc\u062f! \u0628\u06cc\u0627\u06cc\u06cc\u062f \u0647\u0645\u0647 \u0686\u06cc\u0632 \u0631\u0627 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u0645."],"Oops, the connection failed. Try again.":["\u0627\u0648\u0647\u060c \u0627\u062a\u0635\u0627\u0644 \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062f. \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f."],"Create my account":["\u0627\u06cc\u062c\u0627\u062f \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0645\u0646"],"Take part in the community forum, share & grow together":["\u062f\u0631 \u0627\u0646\u062c\u0645\u0646 \u0645\u0634\u0627\u0631\u06a9\u062a \u06a9\u0646\u06cc\u062f\u060c \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f \u0648 \u0628\u0627 \u0647\u0645 \u0631\u0634\u062f \u06a9\u0646\u06cc\u062f"],"Manage your site with our handy dashboard":["\u0633\u0627\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u067e\u06cc\u0634\u062e\u0648\u0627\u0646 \u062e\u0648\u0628 \u0645\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u06a9\u0646\u06cc\u062f"],"Choose from countless professional templates":["\u0627\u0632 \u0628\u06cc\u0646 \u062a\u0639\u062f\u0627\u062f \u0628\u06cc\u200c\u0634\u0645\u0627\u0631\u06cc \u0642\u0627\u0644\u0628 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc\u060c \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f"],"Then you can:":["\u0633\u067e\u0633 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f:"],"To get the most out of Elementor, we\u2019ll connect your account.":["\u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062d\u062f\u0627\u06a9\u062b\u0631\u06cc \u0627\u0632 \u0627\u0644\u0645\u0646\u062a\u0648\u0631\u060c \u062d\u0633\u0627\u0628 \u062e\u0648\u062f\u0631\u0627 \u0645\u062a\u0635\u0644 \u06a9\u0646\u06cc\u062f."],"Choose how to start creating":["\u0646\u062d\u0648\u0647 \u0634\u0631\u0648\u0639 \u0627\u06cc\u062c\u0627\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f"],"Give your site a name & logo":["\u0628\u0631\u0627\u06cc \u0633\u0627\u06cc\u062a\u062a \u06cc\u0647 \u0627\u0633\u0645 \u0648 \u0644\u0648\u06af\u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646"],"Set your site's theme":["\u067e\u0648\u0633\u062a\u0647 \u0633\u0627\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u06cc\u062f"],"Good to Go":["\u062e\u0648\u0628\u0647!"],"Elementor Account":["\u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0627\u0644\u0645\u0646\u062a\u0648\u0631"],"Create Account":["\u0627\u06cc\u062c\u0627\u062f \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc"],"Elementor Logo":["\u0644\u0648\u06af\u0648\u06cc \u0627\u0644\u0645\u0646\u062a\u0648\u0631"],"Already have Elementor Pro?":["\u0627\u0644\u0645\u0646\u062a\u0648\u0631 \u067e\u0631\u0648 \u0631\u0627 \u0627\u0632 \u0642\u0628\u0644 \u062f\u0627\u0631\u06cc\u062f\u061f"],"And so much more!":["\u0648 \u062e\u06cc\u0644\u06cc \u0628\u06cc\u0634\u062a\u0631!"],"Premium Support":["\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0648\u06cc\u0698\u0647"],"300+ Basic & Pro templates":["\u0628\u06cc\u0634 \u0627\u0632 \u06f3\u06f0\u06f0 \u0642\u0627\u0644\u0628 \u067e\u0627\u06cc\u0647 \u0648 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc"],"90+ Basic & Pro widgets":["\u0628\u06cc\u0634 \u0627\u0632 \u06f9\u06f0 \u0627\u0628\u0632\u0627\u0631\u06a9 \u0633\u0627\u062f\u0647 \u0648 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc"],"My Elementor":["\u0627\u0644\u0645\u0646\u062a\u0648\u0631 \u0645\u0646"],"Site Logo":["\u0644\u0648\u06af\u0648 \u0633\u0627\u06cc\u062a"],"Site Name":["\u0646\u0627\u0645 \u0633\u0627\u06cc\u062a"],"Dynamic Content":["\u0645\u062d\u062a\u0648\u0627\u06cc \u062f\u0627\u06cc\u0646\u0627\u0645\u06cc\u06a9"],"Next":["\u0628\u0639\u062f\u06cc"],"Getting Started":["\u0634\u0631\u0648\u0639 \u0628\u0647 \u06a9\u0627\u0631"],"Skip":["\u067e\u0631\u0634"],"or":["\u06cc\u0627"],"Click here":["\u0627\u06cc\u0646\u062c\u0627 \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f"],"Advanced":["\u067e\u06cc\u0634\u0631\u0641\u062a\u0647"],"Loading":["\u062f\u0631 \u062d\u0627\u0644 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc"]}}}