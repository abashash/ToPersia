g to AI search models\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0628\u062d\u062b \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u2026"],"Provisioning AI tracking workspace\u2026":["\u062c\u0627\u0631\u064d \u062a\u062c\u0647\u064a\u0632 \u0645\u0633\u0627\u062d\u0629 \u062a\u062a\u0628\u0651\u0639 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u2026"],"Authenticating credentials\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0642\u0651\u0642 \u0645\u0646 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\u2026"],"Something went wrong while activating your trial. Please try again.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u0627 \u0623\u062b\u0646\u0627\u0621 \u062a\u0641\u0639\u064a\u0644 \u062a\u062c\u0631\u0628\u062a\u0643. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"30-Day Money-Back Guarantee":["\u0636\u0645\u0627\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u0627"],"Start 15-Day Free Trial":["\u0628\u062f\u0621 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u062c\u0627\u0646\u064a\u0629 \u0644\u0645\u062f\u0629 15 \u064a\u0648\u0645\u0627"],"Upgrade to unlock AI Visibility module and see where your brand appears across ChatGPT, and other AI platforms, and take action before you fall further behind.":["\u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0644\u0641\u062a\u062d \u0648\u062d\u062f\u0629 AI Visibility \u0648\u0645\u0639\u0631\u0641\u0629 \u0623\u064a\u0646 \u062a\u0638\u0647\u0631 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0639\u0628\u0631 ChatGPT \u0648\u063a\u064a\u0631\u0647 \u0645\u0646 \u0645\u0646\u0635\u0651\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0648\u0627\u062a\u0651\u062e\u0630 \u0625\u062c\u0631\u0627\u0621 \u0642\u0628\u0644 \u0623\u0646 \u062a\u062a\u0631\u0627\u062c\u0639 \u0623\u0643\u062b\u0631."],"Your competitors are already tracking their AI presence. You should be too.":["\u0645\u0646\u0627\u0641\u0633\u0648\u0643 \u064a\u062a\u062a\u0628\u0651\u0639\u0648\u0646 \u062d\u0636\u0648\u0631\u0647\u0645 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0628\u0627\u0644\u0641\u0639\u0644. \u0648\u0639\u0644\u064a\u0643 \u0623\u0646 \u062a\u0641\u0639\u0644 \u0645\u062b\u0644\u0647\u0645."],"Upgrade to Unlock AI Visibility":["\u0642\u0645 \u0628\u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0644\u0641\u062a\u062d AI Visibility"],"Spot opportunities to grow your AI-driven traffic":["\u0627\u0643\u062a\u0634\u0641 \u0641\u0631\u0635 \u0646\u0645\u0648\u0651 \u0632\u064a\u0627\u0631\u0627\u062a\u0643 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a"],"Benchmark your AI visibility against competitors":["\u0642\u0627\u0631\u0646 \u0638\u0647\u0648\u0631\u0643 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u064a\u0646"],"See which pages AI models cite as sources":["\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u0634\u0647\u062f \u0628\u0647\u0627 \u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0643\u0645\u0635\u0627\u062f\u0631"],"Monitor sentiment across AI search results":["\u0631\u0627\u0642\u0628 \u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u0639\u0628\u0631 \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0628\u062d\u062b \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a"],"Track how often AI mentions your brand":["\u062a\u062a\u0628\u0651\u0639 \u0639\u062f\u062f \u0645\u0631\u0651\u0627\u062a \u0630\u0643\u0631 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629"],"Adding\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u0625\u0636\u0627\u0641\u0629\u2026"],"Description is required.":["\u0627\u0644\u0648\u0635\u0641 \u0645\u0637\u0644\u0648\u0628."],"Website URL is required.":["\u0631\u0627\u0628\u0637 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0637\u0644\u0648\u0628."],"Please enter a valid URL (must start with https:\/\/).":["\u064a\u064f\u0631\u062c\u0649 \u0625\u062f\u062e\u0627\u0644 \u0631\u0627\u0628\u0637 \u0635\u0627\u0644\u062d (\u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u062f\u0623 \u0628\u0640 https:\/\/)."],"Brand name is required.":["\u0627\u0633\u0645 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0645\u0637\u0644\u0648\u0628."],"AI Platforms":["\u0645\u0646\u0635\u0651\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a"],"Frequency of analyses":["\u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a"],"Target Country (Optional)":["\u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"],"Describe what your brand\/product does, who it's for, and what makes it unique. This helps AI models identify and accurately represent you.":["\u0635\u0650\u0641 \u0645\u0627 \u062a\u0642\u062f\u0651\u0645\u0647 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0645\u0646\u062a\u062c\u0643\u060c \u0648\u0644\u0645\u0646 \u0647\u0648 \u0645\u0648\u062c\u064e\u0651\u0647\u060c \u0648\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u0645\u064a\u0651\u0632\u0647. \u064a\u0633\u0627\u0639\u062f \u0647\u0630\u0627 \u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u064a\u0643 \u0648\u062a\u0645\u062b\u064a\u0644\u0643 \u0628\u062f\u0642\u0651\u0629."],"How would you describe your brand\/product?":["\u0643\u064a\u0641 \u062a\u0635\u0641 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0645\u0646\u062a\u062c\u0643\u061f"],"Brand \/ Product URL":["\u0631\u0627\u0628\u0637 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \/ \u0627\u0644\u0645\u0646\u062a\u062c"],"Enter your brand or product name":["\u0623\u062f\u062e\u0644 \u0627\u0633\u0645 \u0639\u0644\u0627\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0645\u0646\u062a\u062c\u0643"],"Brand \/ Product Name":["\u0627\u0633\u0645 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \/ \u0627\u0644\u0645\u0646\u062a\u062c"],"Share the basics so we can start tracking this brand or a product.":["\u0634\u0627\u0631\u0643 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0627\u062a \u0644\u0646\u0628\u062f\u0623 \u062a\u062a\u0628\u0651\u0639 \u0647\u0630\u0647 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0623\u062d\u062f \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a."],"Add Brand or Product":["\u0625\u0636\u0627\u0641\u0629 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0645\u0646\u062a\u062c"],"Edit Brand or Product":["\u062a\u062d\u0631\u064a\u0631 \u0639\