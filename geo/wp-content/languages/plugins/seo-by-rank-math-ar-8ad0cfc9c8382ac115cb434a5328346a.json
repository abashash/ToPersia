27\u0645\u062a\u0643 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0623\u0648\u0644\u0649"],"Add a brand or a specific product to see how you rank against competitors. Monitor your AI visibility, discover where you stand, and uncover opportunities to grow.":["\u0623\u0636\u0641 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0645\u0646\u062a\u062c\u0627 \u0645\u062d\u062f\u0651\u062f\u0627 \u0644\u062a\u0631\u0649 \u062a\u0631\u062a\u064a\u0628\u0643 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u064a\u0646. \u0631\u0627\u0642\u0628 \u0638\u0647\u0648\u0631\u0643 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a\u060c \u0648\u0627\u0643\u062a\u0634\u0641 \u0645\u0648\u0642\u0639\u0643\u060c \u0648\u0627\u0628\u062d\u062b \u0639\u0646 \u0641\u0631\u0635 \u0627\u0644\u0646\u0645\u0648."],"No brands or products tracked yet":["\u0644\u0627 \u062a\u0648\u062c\u062f \u0639\u0644\u0627\u0645\u0627\u062a \u062a\u062c\u0627\u0631\u064a\u0629 \u0623\u0648 \u0645\u0646\u062a\u062c\u0627\u062a \u0645\u064f\u062a\u062a\u0628\u064e\u0651\u0639\u0629 \u0628\u0639\u062f"],"Average number of AI-generated mentions across all tracked brands.":["\u0645\u062a\u0648\u0633\u0651\u0637 \u0639\u062f\u062f \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0648\u0644\u0651\u062f\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u064f\u062a\u062a\u0628\u064e\u0651\u0639\u0629."],"Avg mentions per brand":["\u0645\u062a\u0648\u0633\u0651\u0637 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0644\u0643\u0644 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629"],"Total analysis runs completed in the past 24 hours.":["\u0625\u062c\u0645\u0627\u0644\u064a \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u064024 \u0633\u0627\u0639\u0629 \u0627\u0644\u0645\u0627\u0636\u064a\u0629."],"Analyses in last 24h":["\u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0641\u064a \u0622\u062e\u0631 24 \u0633\u0627\u0639\u0629"],"Average rank score across all tracked brands.":["\u0645\u062a\u0648\u0633\u0651\u0637 \u062f\u0631\u062c\u0629 \u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u064f\u062a\u062a\u0628\u064e\u0651\u0639\u0629."],"Global AI Visibility Score":["\u062f\u0631\u062c\u0629 \u0627\u0644\u0638\u0647\u0648\u0631 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a"],"Action failed. Please try again.":["\u0641\u0634\u0644 \u0627\u0644\u0625\u062c\u0631\u0627\u0621. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Something went wrong. Please try again.":["\u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u0627. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Brand added! The first analysis is running \u2014 data will appear in approximately 10 minutes.":["\u0623\u064f\u0636\u064a\u0641\u062a \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629! \u064a\u062c\u0631\u064a \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0623\u0648\u0644 \u0627\u0644\u0622\u0646\u060c \u0648\u0633\u062a\u0638\u0647\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u062e\u0644\u0627\u0644 10 \u062f\u0642\u0627\u0626\u0642 \u062a\u0642\u0631\u064a\u0628\u0627."],"Stop tracking \"%s\"? You can re-enable it later.":["\u0625\u064a\u0642\u0627\u0641 \u062a\u062a\u0628\u0651\u0639 \u00ab%s\u00bb\u061f \u064a\u0645\u0643\u0646\u0643 \u0625\u0639\u0627\u062f\u0629 \u062a\u0645\u0643\u064a\u0646\u0647 \u0644\u0627\u062d\u0642\u0627."],"Resume tracking \"%s\"? Analysis will run on the next scheduled cycle.":["\u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u062a\u062a\u0628\u0651\u0639 \u00ab%s\u00bb\u061f \u0633\u064a\u064f\u0634\u063a\u064e\u0651\u0644 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0641\u064a \u0627\u0644\u062f\u0648\u0631\u0629 \u0627\u0644\u0645\u062c\u062f\u0648\u0644\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629."],"Deactivate brand?":["\u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629\u061f"],"Activate brand?":["\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629\u061f"],"\u2190 Back to Dashboard":["\u2190 \u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"],"Brand not found.":["\u0644\u0645 \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u0649 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629."],"Failed to save brand.":["\u062a\u0639\u0630\u0651\u0631 \u062d\u0641\u0638 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629."],"Failed to load insights.":["\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0631\u0624\u0649."],"Failed to load brand.":["\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629."],"Raw data \/ Transcripts":["\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0627\u0645 \/ \u0627\u0644\u0646\u0635\u0648\u0635"],"Competitors":["\u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0648\u0646"],"Queries":["\u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a"],"Transcripts will appear here once the first analysis completes.":["\u0633\u062a\u0638\u0647\u0631 \u0627\u0644\u0646\u0635\u0648\u0635 \u0647\u0646\u0627 \u0628\u0645\u062c\u0631\u0651\u062f \u0627\u0643\u062a\u0645\u0627\u0644 \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0623\u0648\u0644."],"No transcripts found":["\u0644\u0627 \u062a\u0648\u062c\u062f \u0646\u0635\u0648\u0635"],"Competitor":["\u0645\u0646\u0627\u0641\u0633"],"Competitors are automatically identified during analysis runs.":["\u064a\u064f\u0643\u062a\u0634\u064e\u0641 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0648\u0646 \u062a\u0644\u0642\u0627\u0626\u064a\u0627 \u0623\u062b\u0646\u0627\u0621 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644."],"No competitors detected yet":["\u0644\u0645 \u064a\u064f\u0643\u062a\u0634\u064e\u0641 \u0623\u064a \u0645\u0646\u0627\u0641\u0633\u064a\u0646 \u0628\u0639\u062f"],"This will replace all existing baseline queries with new AI-generated ones. Continue?":["\u0633\u064a\u0624\u062f\u0651\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0628\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0645\u0648\u0644\u0651\u062f\u0629 \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a. \u0647\u0644 \u062a\u0631\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u061f"],"Regenerate queries?":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a\u061f"],"Query text":["\u0646\u0635 \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645"],"Regenerate baseline queries to start tracking how AI answers questions about this brand.":["\u0623\u0639\u062f \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0644\u0628\u062f\u0621 \u062a\u062a\u0628\u0651\u0639 \u0643\u064a\u0641\u064a\u0629 \u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0646 \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0645\u062a\u0639\u0644\u0651\u0642\u0629 \u0628\u0647\u0630\u0647 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629."],"No queries yet":["\u0644\u0627 \u062a\u0648\u062c\u062f \u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0628\u0639\u062f"],"Regenerate baseline queries":["\u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629"],"Regenerating\u2026":["\u062c\u0627\u0631\u064d \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u0644\u064a\u062f\u2026"],"The competitor brand with the highest share of voice in AI mentions.":["\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0629 \u0635\u0627\u062d\u0628\u0629 \u0623\u0639\u0644\u0649 \u062d\u0635\u0651\u0629 \u0645\u0646 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a."],"Top Competitor":["\u0623\u0628\u0631\u0632 \u0645\u0646\u0627\u0641\u0633"],"Average sentiment score across all AI mentions of this brand.":["\u0645\u062a\u0648\u0633\u0651\u0637 \u062f\u0631\u062c\u0629 \u0627\u0644\u0645\u0634\u0627\u0639\u0631 \u0639\u0628\u0631 \u062c\u0645\u064a\u0639 \u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0647\u0630\u0647 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629."],"Avg Sentiments":["\u0645\u062a\u0648\u0633\u0651\u0637 \u0627\u0644\u0645\u0634\u0627\u0639\u0631"],"Total brand mentions across AI-generated content.":["\u0625\u062c\u0645\u0627\u0644\u064a \u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0639\u0628\u0631 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u0648\u0644\u0651\u062f \u0628\u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a."],"Recent Mentions":["\u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0623\u062e\u064a\u0631\u0629"],"AI Visibility Score for this brand across AI platforms.":["\u062f\u0631\u062c\u0629 \u0627\u0644\u0638\u0647\u0648\u0631 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0647\u0630\u0647 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0639\u0628\u0631 \u0645\u0646\u0635\u0651\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a."],"Last analysis:":["\u0622\u062e\u0631 \u062a\u062d\u0644\u064a\u0644:"],"Open brand URL":["\u0641\u062a\u062d \u0631\u0627\u0628\u0637 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629"],"Edit Brand":["\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629"],"Export Report":["\u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u062a\u0642\u0631\u064a\u0631"],"Brand detail":["\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629"],"Actions":["\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a"],"Last analyzed":["\u0622\u062e\u0631 \u062a\u062d\u0644\u064a\u0644"],"Citations":["\u0627\u0644\u0627\u0633\u062a\u0634\u0647\u0627\u062f\u0627\u062a"],"Mentions":["\u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a"],"Avg sentiment":["\u0645\u062a\u0648\u0633\u0651\u0637 \u0627\u0644\u0645\u0634\u0627\u0639\u0631"],"Avg Rank":["\u0645\u062a\u0648\u0633\u0651\u0637 \u0627\u0644\u062a\u0631\u062a\u064a\u0628"],"AI Visibility Score":["\u062f\u0631\u062c\u0629 \u0627\u0644\u0638\u0647\u0648\u0631 \u0641\u064a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a"],"Search name or URL":["\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645 \u0623\u0648 \u0627\u0644\u0631\u0627\u0628\u0637"],"+ Add Brand \/ Product":["+ \u0625\u0636\u0627\u0641\u0629 \u0639\u0644\u0627\u0645\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \/ \u0645\u0646\u062a\u062c"],"I'll do this later":["\u0633\u0623\u0641\u0639\u0644 \u0647\u0630\u0627 \u0644\u0627\u062d\u0642\u0627"],"All plans include a 30-day money-back guarantee.":["\u062a\u0634\u0645\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u062e\u0637\u0637 \u0636\u0645\u0627\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u062e\u0644\u0627\u0644 30 \u064a\u0648\u0645\u0627."],"Upgrade Your Plan":["\u062a\u0631\u0642\u064a\u0629 \u062e\u0637\u0651\u062a\u0643"],"You've reached the brand limit for your current %s plan.":["\u0644\u0642\u062f \u0628\u0644\u063a\u062a \u062d\u062f\u0651 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0644\u062e\u0637\u0651\u062a\u0643 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 %s."],"You've reached the maximum number of brands available on your plan. Contact support if you need a higher limit.":["\u0644\u0642\u062f \u0628\u0644\u063a\u062a \u0627\u0644\u062d\u062f\u0651 \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0639\u062f\u062f \u0627\u0644\u0639\u0644\u0627\u06