msgid "\"Auto Cleanup\" mode is ON, "
msgstr "حالت \"پاکسازی خودکار\" روشن است، "

msgid "%1$d backup record was deleted. Failed to delete %2$d."
msgid_plural "%1$d backup records were deleted. Failed to delete %2$d."
msgstr[0] "%1$d رکورد بکاپ حذف شد. %2$d حذف نشد."
msgstr[1] "%1$d رکورد بکاپ حذف شد. %2$d حذف نشد."

msgctxt ""
"%1$d is the number of invalid records, %2$d is the total number of records"
msgid "%1$d of %2$d backup records don't exist in any of their storages."
msgstr "%1$d از %2$d سابقه پشتیبان در هیچ یک از فضای ذخیره‌سازی آنها وجود ندارد."

msgid "%1$s - Copy"
msgstr "%1$s - کپی"

msgctxt "%1$s = \"is dynamic\" or \"value is fixed\" based on settings"
msgid "(default) - %1$s"
msgstr "(پیش فرض) - %1$s"

msgctxt "%1$s = name of schedule"
msgid "Created by schedule %1$s"
msgstr "ایجاد شده توسط برنامه %1$s"

msgctxt "%1$s and %2$s are <a> tags"
msgid "For additional help visit the %1$sonline faq%2$s."
msgstr "برای راهنمایی بیشتر به %1$sسوالات متداول%2$s مراجعه کنید."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sBackups infos:%2$s Information about the Backups created and the type of "
"components included."
msgstr ""
"%1$sاطلاعات بکاپ:%2$s اطلاعات مربوط به بکاپ ایجاد شده و نوع مولفه‌های موجود."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sDuplicator Version:%2$s So we know which versions of Duplicator are "
"potentially responsible for issues when we get bug reports, \n"
"                allowing us to identify issues and release solutions much "
"faster."
msgstr ""
"%1$sنسخه داپلیکیتور:%2$s باعث میشود بدانیم که کدام نسخه‌های داپلیکیتوربه طور "
"بالقوه مسئول مشکلاتی هستند که گزارش‌های اشکال را دریافت می‌کنیم، که به ما امکان "
"می‌دهد مشکلات را شناسایی کرده و راه‌حل‌ها را بسیار سریع‌تر منتشر کنیم."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sLicense key and email and url:%2$s If you're a Duplicator customer, then we "
"use this to determine if there's an issue \n"
"                with your specific license key, and to link the profile of your "
"site with the configuration of authentication to allow us to \n"
"                determine if there are issues with your Duplicator "
"authentication."
msgstr ""
"%1$sلایسنس و ایمیل و آدرس اینترنتی:%2$s اگر مشتری داپلیکیتور هستید، ما از این "
"برای تعیین اینکه آیا مشکلی با لایسنس خاص شما وجود دارد یا خیر، استفاده می‌کنیم و "
"پروفایل سایت شما را با پیکربندی احراز هویت لینک می‌دهیم تا  تشخیص دهیم که آیا "
"مشکلی در تأیید اعتبار داپلیکیتور شما وجود دارد یا خیر."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sMySQL Version:%2$s So we know which versions of MySQL to support and test "
"against for our custom tables."
msgstr ""
"%1$sMySQL نسخه:%2$s نیاز است تا بدانیم که کدام نسخه از MySQL را برای جداول "
"سفارشی خود پشتیبانی و آزمایش کنیم."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sPHP Version:%2$s So we know which PHP versions we have to test against (no "
"one likes whitescreens or log files full of errors)."
msgstr ""
"%1$sPHP نسخه:%2$s اطلاعاتی که نیاز است تا بدانیم که باید در برابر کدام نسخه های "
"PHP تست کنیم (هیچ کس صفحه سفید یا فایل های لاگ پر از خطا را دوست ندارد)."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sPlugins and Themes infos:%2$s So we can figure out which ones can generate "
"compatibility errors with Duplicator."
msgstr ""
"%1$sاطلاعات افزونه‌ها و قالب‌ها:%2$s باعث میشود بدانیم که کدام یک می توانند "
"خطاهای سازگاری با داپلیکیتور ایجاد کنند."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid "%1$sSchedule infos:%2$s Information on how schedules are used."
msgstr "%1$sاطلاعات برنامه ریزی:%2$s اطلاعات در مورد نحوه استفاده از برنامه ریزی."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sSite info:%2$s General information about the site such as database, file "
"size, number of users, and sites in case it is a multisite. \n"
"                This is useful for us to understand the critical issues of "
"Backup creation."
msgstr ""
"%1$sاطلاعات سایت:%2$s اطلاعات عمومی درباره سایت مانند پایگاه داده، اندازه فایل، "
"تعداد کاربران و سایت ها در صورتی که سایت شبکه باشد.\n"
"                این برای درک مسائل مهم ایجاد بکاپ مفید است."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sStorage infos:%2$s Information about the type of storage used, \n"
"                this data is useful for us to understand how to improve our "
"support for external storages.(Only anonymized data is sent)."
msgstr ""
"%1$sاطلاعات فضای ذخیره‌سازی:%2$s اطلاعات مربوط به نوع فضای ذخیره‌سازی مورد "
"استفاده،\n"
"                این داده‌ها برای درک نحوه بهبود پشتیبانی از حافظه‌های خارجی مفید "
"است. (فقط داده‌های ناشناس ارسال می‌شوند)."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid "%1$sTemplate infos:%2$s Information about the template components."
msgstr "%1$sاطلاعات تمپلیت:%2$s اطلاعات مربوط به مولفه‌های تمپلیت."

msgctxt "%1$s and %2$s are are opening and closing bold (<b></b>) tags"
msgid ""
"%1$sWordPress Version:%2$s So we know which WordPress versions to support and "
"test against."
msgstr ""
"%1$sنسخه وردپرس:%2$s نیاز است تا بدانیم که کدام نسخه وردپرس را پشتیبانی کرده و "
"با آن تست کنیم."

msgctxt "%1$s and %2$s are html anchor tags or link"
msgid "For a list of supported hosting providers %1$sclick here%2$s."
msgstr "برای مشاهده لیست هاستینگ‌های پشتیبانی شده %1$sاینجا کلیک کنید%2$s."

msgctxt "%1$s and %2$s are html anchor tags or link"
msgid "Shell Zip is %1$srecommended%2$s when available. "
msgstr "در صورت در دسترس بودن Shell Zip این گزینه %1$sپیشنهاد%2$s میشود. "

msgctxt "%1$s and %2$s are html anchor tags or link"
msgid ""
"The mysqldump program at custom path exists but is not executable. Please check "
"file permission \n"
"                            to resolve this problem. Please check this %1$sFAQ "
"page%2$s for possible solution."
msgstr ""
"برنامه mysqldump در مسیر سفارشی وجود دارد اما قابل اجرا نیست. لطفا پرمیشن های "
"فایل را بررسی کنید\n"
"                            تا مشکل حل شود. لطفاً %1$s پرسش‌های متداول%2$s را "
"برای راه‌حل احتمالی بررسی کنید."

msgctxt "%1$s and %2$s are html anchor tags or link"
msgid ""
"The mysqldump program at its default location exists but is not executable. \n"
"                            Please check file permission to resolve this "
"problem. Please check this %1$sFAQ page%2$s for possible solution."
msgstr ""
"برنامه mysqldump در محل پیش فرض خود وجود دارد، اما قابل اجرا نیست. \n"
"                            لطفاً پرمیشن فایل را برای حل این مشکل بررسی کنید."
"لطفاً %1$s پرسش‌های متداول%2$s را برای راه‌حل احتمالی بررسی کنید."

msgctxt "%1$s and %2$s are html anchor tags or links"
msgid ""
"The mysqldump program was not found at its custom path location. \n"
"                        Please check is there some typo mistake or mysqldump "
"program exists on that location. \n"
"                        Also you can leave custom path empty to force automatic "
"settings. If the problem persist \n"
"                        contact your server admin for the correct path. For a "
"list of approved providers that support mysqldump %1$sclick here%2$s."
msgstr ""
"برنامه mysqldump در محل مسیر سفارشی خود یافت نشد. \n"
"                        لطفاً بررسی کنید که آیا خطای تایپی یا برنامه mysqldump "
"در آن مکان وجود دارد. \n"
"                        همچنین می‌توانید مسیر سفارشی را خالی بگذارید تا تنظیمات "
"خودکار اعمال شود. اگر مشکل ادامه پیدا کرد \n"
"                        برای مسیر صحیح با ادمین سرور خود تماس بگیرید. برای "
"مشاهده لیستی از ارائه دهندگان تأیید شده که از mysqldump پشتیبانی می کنند،"
"%1$sاینجا%2$s کلیک کنید."

msgctxt "%1$s and %2$s are html anchor tags or links"
msgid ""
"The mysqldump program was not found at its default location or the custom path "
"below. \n"
"                    Please enter a valid path where mysqldump can run. If the "
"problem persist contact your \n"
"                    server admin for the correct path. For a list of approved "
"providers that support mysqldump %1$sclick here%2$s."
msgstr ""
"برنامه mysqldump در مکان پیش فرض یا مسیر سفارشی زیر یافت نشد. \n"
"                    لطفاً یک مسیر معتبر که در آن mysqldump می‌تواند اجرا شود را "
"وارد کنید. اگر مشکل ادامه داشت، برای مسیر صحیح \n"
"                     با ادمین سرور خود تماس بگیرید. برای مشاهده لیستی از ارائه "
"دهندگان تأیید شده که از mysqldump پشتیبانی می کنند، %1$sاینجا%2$s کلیک کنید."

msgctxt "%1$s and %2$s are opening and closing anchor tags"
msgid ""
"When installing a database only backup please visit the %1$sdatabase only quick "
"start%2$s"
msgstr ""
"هنگام نصب یک بکاپ فقط پایگاه داده، لطفاً از %1$s شروع سریع فقط پایگاه داده%2$s "
"استفاده کنید."

msgctxt "%1$s and %2$s are opening and closing bold tags (<b> and </b>)"
msgid ""
"The mode has %1$sswitched to advanced%2$s because more backups have been "
"detected in the import folder."
msgstr ""
"حالت به %1$sپیشرفته%2$s تغییر یافته ، زیرا بکاپ بیشتری در پوشه درون ریزی "
"شناسایی شده است."

msgctxt "%1$s and %2$s are opening and closing link tags to the documentation."
msgid "Learn %1$show to disable%2$s."
msgstr "آموزش %1$sنحوه غیرفعال سازی%2$s."

msgctxt ""
"%1$s and %2$s are the opening and close <a> tags to the summary preview link"
msgid "You can view the email summary example %1$shere%2$s."
msgstr "می توانید نمونه خلاصه ایمیل را در %1$sاینجا%2$s مشاهده کنید."

msgctxt "%1$s and %2$s are the opening and closing anchor tags"
msgid "- %1$sCheck WordPress Updates%2$s"
msgstr "- %1$sبررسی بروز رسانی‌های وردپرس%2$s"

msgctxt "%1$s and %2$s are the opening and closing anchor tags"
msgid "This is a %1$sWordPress Setting%2$s"
msgstr "این از %1$sتنظیمات وردپرس%2$s میباشد"

msgctxt ""
"%1$s and %2$s are the opening and closing tags for the link to the online docs."
msgid ""
"Could not fetch help information. Please try again later or visit the "
"%1$sonline docs%2$s."
msgstr ""
"اطلاعات راهنما دریافت نشد. لطفاً بعداً دوباره امتحان کنید یا از %1$sمستندات آنلاین"
"%2$s استفاده کنید."

msgctxt "%1$s and %2$s are the opening and closing tags of a link."
msgid "FAQ: %1$sHow to enable disabled PHP functions.%2$s"
msgstr "سؤالات متداول: %1$sچگونه توابع غیرفعال PHP را فعال کنیم.%2$s"

msgctxt "%1$s and %2$s are the opening and closing tags of a link."
msgid ""
"For a list of approved providers that support these functions, %1$sclick here"
"%2$s."
msgstr ""
"برای مشاهده لیستی از ارائه دهندگان تأیید شده که از این توابع پشتیبانی می کنند، "
"%1$sاینجا کلیک کنید%2$s."

msgctxt "%1$s and %2$s are the options not included in the license."
msgid "The %1$s and %2$s options are not included in your license plan."
msgstr "گزینه‌های %1$s و %2$s در پلن لایسنس شما گنجانده نشده‌اند."

msgctxt "%1$s and %2$s represent opening and closing anchor tags"
msgid ""
"Please change the setting SQL Mode to PHP Code.\n"
"                            You can do that by opening %1$sDuplicator Pro > "
"Settings > Backups.%2$s"
msgstr ""
"لطفاً تنظیمات حالت SQL را به کد PHP تغییر دهید.\n"
"                            برای انجام این کار به %1$sداپلیکیتور پرو > تنظیمات "
"> بکاپ‌ها%2$s بروید"

msgctxt "%1$s and %2$s represent opening and closing bold (<b> and </b>) tags"
msgid ""
"Include the plugins in the Backup. With the %1$sactive only%2$s option enabled, "
"only active plugins will be included in the Backup."
msgstr ""
"افزونه‌ها را در بکاپ بگنجانید. با فعال بودن گزینه %1$sفقط فعال%2$s، فقط "
"افزونه‌های فعال در بکاپ گنجانده می‌شوند."

msgctxt "%1$s and %2$s represent opening and closing bold (<b> and </b>) tags"
msgid ""
"Include the themes in the Backup. With the %1$sactive only%2$s option enabled, "
"only active themes will be included in the Backup."
msgstr ""
"قالب‌ها (themes) را در بکاپ قرار دهید. با فعال بودن گزینه %1$sفقط فعال%2$s، فقط "
"قالب‌ فعال در بکاپ گنجانده می‌شود."

msgctxt "%1$s and %2$s represent opening and closing bold tags"
msgid ""
"%1$sNote:%2$s Schedules require web site traffic in order to start a build. \n"
"                            If you set a start time of 06:00 daily but do not "
"get any traffic till 10:00 then the build will not start until 10:00. \n"
"                            If you have low traffic consider setting up a cron "
"job to periodically hit your site."
msgstr ""
"%1$sتوجه:%2$s برنامه ریزی ها برای شروع ساخت نیاز به ترافیک وب سایت دارند. \n"
"                            اگر ساعت شروع روزانه را 06:00 تنظیم کنید اما تا "
"ساعت 10:00 ترافیک نداشته باشید، ساخت تا ساعت 10:00 شروع نمی شود. \n"
"                            اگر ترافیک پایینی دارید، یک cron job راه اندازی "
"کنید تا به طور دوره ای سایت خود را مشاهده کنید."

msgctxt ""
"%1$s and %2$s represent the opening and closing anchor tags (<a> and </a>)"
msgid "To go to the \"Backups\" screen %1$sclick here%2$s."
msgstr "برای رفتن به صفحه \"بکاپ‌ها\" %1$sاینجا کلیک کنید%2$s."

msgctxt "%1$s and %2$s represent the opening and closing link tags (<a> and </a>)"
msgid ""
"If the installer does not start automatically, you can click on this %1$slink "
"and start it manually%2$s."
msgstr ""
"اگر اینستالر به طور خودکار شروع نمی‌شود، می‌توانید %1$sروی این لینک کلیک کرده و "
"به صورت دستی%2$s شروع کنید."

msgctxt ""
"%1$s and %2$s represents the opening and closing HTML tags for an anchor or link"
msgid ""
"%1$sDisaster Recovery%2$s makes it quick and easy to restore your site during "
"an emergency. \n"
"            You don’t need WordPress to be working for this. \n"
"            Just keep the Disaster Recovery Link in a safe spot and use it when "
"needed, or use the Launcher to restore your backup."
msgstr ""
"%1$sبازیابی بحران%2$s بازیابی سایت شما را در مواقع اضطراری سریع و آسان می‌کند. \n"
"            برای این کار نیازی به وردپرس ندارید. \n"
"            کافیست لینک بازیابی بحران را در مکانی امن نگه دارید و در صورت نیاز "
"از آن استفاده کنید یا از راه‌انداز برای بازیابی نسخه پشتیبان خود استفاده کنید.."

msgctxt ""
"%1$s and %2$s represents the opening and closing HTML tags for an anchor or link"
msgid ""
"- In some hosting the execution of PHP scripts are blocked in the wp-content "
"folder, %1$s[try set a custom recovery path]%2$s"
msgstr ""
"- در برخی از هاست ها اجرای اسکریپت های PHP در پوشه wp-content مسدود شده است، "
"%1$s[سعی کنید یک مسیر بازیابی سفارشی تنظیم کنید]%2$s"

msgctxt ""
"%1$s and %2$s represents the opening and closing HTML tags for an anchor or link"
msgid "Change the %1$sArchive Engine%2$s settings to DupArchive."
msgstr "تنظیمات %1$sموتور آرشیو%2$s را به DupArchive تغییر دهید."

msgctxt ""
"%1$s and %2$s represents the opening and closing HTML tags for an anchor or link"
msgid ""
"For detailed steps on how to enable cURL please see <b>Solution 3, Issue A</b> "
"in %1$sthis FAQ Entry%2$s."
msgstr ""
"برای آموزش دقیق در مورد نحوه فعال کردن cURL، لطفاً به <b>راه‌حل 3، شماره A</b> در "
"%1$s این سؤالات متداول%2$s مراجعه کنید."

msgctxt ""
"%1$s and %2$s represents the opening and closing HTML tags for an anchor or link"
msgid "For more details please see the %1$suser guide%2$s"
