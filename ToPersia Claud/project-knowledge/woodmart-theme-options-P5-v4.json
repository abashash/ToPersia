لت تیره: متغیرهای شما + متغیرهای بومی Woodmart + Elementor ============ */\r\nhtml[data-theme=\"dark\"]{\r\n  /* --- متغیرهای اختصاصی شما --- */\r\n  --bg-0:#001A33; --bg-1:#083461;\r\n  --text:#E7EBF4; --text-muted:#70869E; --text-disabled:rgba(255,255,255,.38);\r\n  --link:#94AAC2; --link-hover:#FFCC66;\r\n  --btn-primary:#3C6A9B; --btn-primary-fg:#FFFFFF;\r\n  --btn-secondary:#FFCC66; --btn-secondary-fg:#001A33;\r\n  --border:#3C6A9B; --focus:#FFCC66;\r\n\r\n  /* --- بازتعریف متغیرهای بومی Woodmart (تأییدشده) تا کامپوننت‌های قالب همراهی کنند --- */\r\n  --wd-text-color:#E7EBF4;\r\n  --wd-title-color:#FFFFFF;\r\n  --wd-link-color:#94AAC2;\r\n  --wd-link-color-hover:#FFCC66;\r\n  --wd-primary-color:#3C6A9B;\r\n  --wd-alternative-color:#FFCC66;   /* رنگ «ثانویه» در Woodmart با نام alternative است */\r\n  --wd-entities-title-color:#E7EBF4;\r\n  --wd-entities-title-color-hover:#FFCC66;\r\n  --wd-widget-title-color:#FFFFFF;\r\n  --btn-accent-bgcolor:#3C6A9B;      /* نام صحیح: accent، نه accented */\r\n  --btn-accent-bgcolor-hover:#325a84;\r\n  --btn-accent-color:#FFFFFF;\r\n  --btn-default-bgcolor:#083461;\r\n  --btn-default-color:#E7EBF4;\r\n  --btn-default-color-hover:#FFFFFF;\r\n\r\n  /* --- بازنویسی متغیرهای گلوبال Elementor (نام‌های عمومی؛ شناسه‌های سفارشی را از Inspector بردارید) --- */\r\n  --e-global-color-primary:#3C6A9B;\r\n  --e-global-color-secondary:#94AAC2;\r\n  --e-global-color-text:#E7EBF4;\r\n  --e-global-color-accent:#FFCC66;\r\n}\r\n\r\n/* ============ ۳) override صریح — پس‌زمینه‌ها با متغیر کنترل نمی‌شوند، پس مستقیم می‌زنیم ============ */\r\n\r\n/* بدنه و متن پایه */\r\nhtml[data-theme=\"dark\"] body{ background-color:var(--bg-0)!important; color:var(--text)!important; }\r\n\r\n/* رَپِر اصلی محتوا (علت اصلی باگ) — سلکتورهای تأییدشدهٔ Woodmart */\r\nhtml[data-theme=\"dark\"] main.wd-content-layout,\r\nhtml[data-theme=\"dark\"] .content-layout-wrapper,\r\nhtml[data-theme=\"dark\"] .main-page-wrapper,\r\nhtml[data-theme=\"dark\"] .wd-page-content,\r\nhtml[data-theme=\"dark\"] .wd-content-layout{\r\n  background-color:var(--bg-0)!important;\r\n  color:var(--text)!important;\r\n}\r\n\r\n/* هدر (Header Builder) — ردیف‌ها و حالت sticky */\r\nhtml[data-theme=\"dark\"] .whb-header,\r\nhtml[data-theme=\"dark\"] .whb-general-header,\r\nhtml[data-theme=\"dark\"] .whb-top-bar,\r\nhtml[data-theme=\"dark\"] .whb-header-bottom,\r\nhtml[data-theme=\"dark\"] .whb-header .whb-row,\r\nhtml[data-theme=\"dark\"] .whb-sticked .whb-general-header{\r\n  background-color:var(--bg-1)!important;\r\n}\r\n/* رنگ متن/لینک منوی اصلی هدر */\r\nhtml[data-theme=\"dark\"] .whb-header .wd-nav[class*=\"wd-style-\"]>li>a,\r\nhtml[data-theme=\"dark\"] .whb-header .wd-tools-element>a,\r\nhtml[data-theme=\"dark\"] .whb-header a{\r\n  color:var(--text)!important;\r\n}\r\nhtml[data-theme=\"dark\"] .whb-header .wd-nav[class*=\"wd-style-\"]>li>a:hover{ color:var(--link-hover)!important; }\r\n\r\n/* سایدبار و ویجت‌ها */\r\nhtml[data-theme=\"dark\"] .sidebar-content,\r\nhtml[data-theme=\"dark\"] .widget,\r\nhtml[data-theme=\"dark\"] .wd-widget,\r\nhtml[data-theme=\"dark\"] .widget_product_categories li a{\r\n  background-color:transparent!important;\r\n  color:var(--text)!important;\r\n}\r\n\r\n/* کارت محصولات با پس‌زمینه */\r\nhtml[data-theme=\"dark\"] .wd-products-with-bg:not(.products-bordered-grid) :is(.product-wrapper,.wd-cat-wrap){\r\n  background-color:var(--bg-1)!important;\r\n}\r\n\r\n/* لینک‌ها و فوکوس (نسخهٔ شما، حفظ‌شده) */\r\nhtml[data-theme=\"dark\"] a{ color:var(--link); }\r\nhtml[data-theme=\"dark\"] a:hover{ color:var(--link-hover); }\r\nhtml[data-theme=\"dark\"] :focus-visible{ outline:2px solid var(--focus); outline-offset:2px; }\r\n\r\n/* فوتر (برای اطمینان صریح شود، نه اتکا به ارث) */\r\nhtml[data-theme=\"dark\"] .wd-footer,\r\nhtml[data-theme=\"dark\"] footer.footer-container,\r\nhtml[data-theme=\"dark\"] .footer-widgets,\r\nhtml[data-theme=\"dark\"] .wd-copyrights{\r\n  background-color:var(--bg-0)!important;\r\n  color:var(--text)!important;\r\n}\r\n\r\n/* ============ ۴) Elementor — سکشن/کانتینرهایی که رنگ inline دارند ============ */\r\n/* هشدار: این‌ها فقط سکشن‌هایی را که رنگ ثابت inline دارند override می‌کنند؛\r\n   اگر رنگ سکشن را از Global Color گرفته باشید، بخش ۲ (متغیرها) کافی است و این را نزنید،\r\n   وگرنه سکشن‌های عمداً روشن هم تیره می‌شوند. با احتیاط و پس از تست استفاده کنید. */\r\nhtml[data-theme=\"dark\"] .elementor-section,\r\nhtml[data-theme=\"dark\"] .e-con,\r\nhtml[data-theme=\"dark\"] .e-con-inner,\r\nhtml[data-theme=\"dark\"] .elementor-widget-wrap{\r\n  background-color:transparent!important;   /* تا پس‌زمینهٔ رَپِر تیره دیده شود */\r\n}\r\n/* در صورت نیاز به رنگ ثابت به‌جای شفاف:\r\nhtml[data-theme=\"dark\"] .elementor-section{ background-color:var(--bg-0)!important; } */\r\n\r\n/* دکمهٔ toggle (نسخهٔ شما، بدون تغییر) */\r\n#topersia-theme-toggle{\r\n  position:fixed; bottom:20px; inset-inline-end:20px; z-index:9999;\r\n  width:44px; height:44px; border-radius:50%;\r\n  background:var(--btn-primary); color:var(--btn-primary-fg);\r\n  border:none; cursor:pointer; font-size:18px; line-height:44px;\r\n  box-shadow:0 2px 8px rgba(0,0,0,.25);\r\n}","css_desktop": "","css_tablet": "","css_wide_mobile": "","css_mobile": "","css_backend": "","custom_js": "(function(){\n  function applyTheme(t){\n    document.documentElement.setAttribute('data-theme', t);\n    try{ localStorage.setItem('topersia-theme', t); }catch(e){}\n  }\n  var saved;\n  try{ saved = localStorage.getItem('topersia-theme'); }catch(e){ saved = null; }\n  var preferred = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');\n  applyTheme(preferred);\n\n  document.addEventListener('DOMContentLoaded', function(){\n    var btn = document.createElement('button');\n    btn.id = 'topersia-theme-toggle';\n    btn.setAttribute('aria-label','تغییر حالت روشن/تیره');\n    btn.textContent = preferred === 'dark' ? '\\u2600' : '\\u263E';\n    btn.onclick = function(){\n      var cur = document.documentElement.getAttribute('data-theme');\n      var next = cur === 'dark' ? 'light' : 'dark';\n      applyTheme(next);\n      btn.textContent = next === 'dark' ? '\\u2600' : '\\u263E';\n    };\n    document.body.appendChild(btn);\n  });\n})();","js_ready": "","sticky_social": false,"sticky_social_type": "follow","sticky_social_position": "right","social_follow_notice": "","fb_link": "#","twitter_link": "#","bluesky_link": "","isntagram_link": "#","threads_link": "","pinterest_link": "#","youtube_link": "#","tumblr_link": "","linkedin_link": "","vimeo_link": "","flickr_link": "","github_link": "","dribbble_link": "","behance_link": "","soundcloud_link": "","spotify_link": "","whatsapp_link": "","snapchat_link": "","tg_link": "","viber_link": "","tiktok_link": "","discord_link": "","yelp_link": "","vk_link": "","ok_link": "","social_email_links": false,"social_share_notice": "","share_fb": "1","share_twitter": "1","share_pinterest": "1","share_linkedin": "1","share_whatsapp": false,"share_tg": "1","share_viber": false,"share_vk": false,"share_ok": false,"share_email": false,"mobile_optimization": false,"load_text_domain": false,"disable_gutenberg_css": false,"styles_inline_size_limit": "40","advanced_css_notice": "","styles_always_use": [],"styles_not_use": [],"disable_owl_mobile_devices": false,"remove_jquery_migrate": false,"advanced_js_notice": "","advanced_js": false,"autocomplete_library": "required","cookie_library": "required","countdown-bundle_library": "required","device_library": "not_use","isotope-bundle_library": "required","justified_library": "required","magnific_library": "required","panr-parallax-bundle_library": "required","parallax_library": "required","parallax-scroll-bundle_library": "required","photoswipe-bundle_library": "required","pjax_library": "required","sticky-kit_library": "required","wd_swiper_library": "required","threesixty_library": "required","tooltips_library": "required","vivus_library": "required","waypoints_library": "required